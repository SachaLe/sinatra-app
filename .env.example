# Titre affiché en haut de la page
WEDDING_TITLE="Léa & Hugo"
# Nom du dossier créé dans votre Google Drive
DRIVE_FOLDER_NAME="Photos du mariage"
# Mot de passe de la page /admin (réservée aux mariés)
ADMIN_PASSWORD=
# Optionnel : si défini, le lien invité devient https://.../?code=CE_CODE
ACCESS_CODE=
# Taille max par fichier, en Mo
MAX_FILE_MB=2048

# Identifiants OAuth Google (étape 1 du README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtenu via /admin -> "Connecter mon Google Drive" (étape 3)
GOOGLE_REFRESH_TOKEN=

# Secret des cookies (64+ caractères aléatoires, ex. `openssl rand -hex 64`)
SESSION_SECRET=
